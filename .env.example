# ==============================================================================
# PROTTABORTON 2.0 — SUPABASE CONFIGURATION
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env or edit supabase.config.js for client-side configuration.
# 2. ONLY the ANON KEY is safe for public client-side browser usage.
# 3. NEVER put the SERVICE_ROLE_KEY in frontend code or commit .env to GitHub.
# ==============================================================================

# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (Project Settings -> API -> Project API keys -> anon/public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (Optional - ONLY used for Edge Functions deployment, NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Edge Function URL (if deploying Edge Functions)
# e.g., https://your-project-ref.supabase.co/functions/v1/record-visit
SUPABASE_EDGE_FUNCTION_URL=
